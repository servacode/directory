NODE_ENV=development
API_PORT=3001
ADMIN_PORT=3000
DATABASE_URL=postgresql://health:health@localhost:5432/health_directory
PUBLIC_API_URL=http://localhost:3001/api/v1
APP_TIMEZONE=Asia/Damascus
DATABASE_POOL_MAX=10
ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
REFRESH_TOKEN_SECRET=replace-with-a-different-32-char-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
CORS_ORIGINS=http://localhost:3000
WHATSAPP_RECOVERY_WEBHOOK_URL=
WHATSAPP_RECOVERY_WEBHOOK_TOKEN=

UPLOAD_DIR=./var/uploads
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=8000
DATABASE_SLOW_QUERY_MS=250
MAP_STYLE_URL=https://demotiles.maplibre.org/style.json

TRUST_PROXY_HOPS=1
OTP_HMAC_SECRET=replace-with-a-different-32-char-secret-for-otp-hmac
