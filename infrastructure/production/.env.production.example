APP_DOMAIN=example.com
TLS_EMAIL=ops@example.com
POSTGRES_DB=health_directory
POSTGRES_USER=health_directory
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://health_directory:replace-with-a-long-random-password@postgres:5432/health_directory
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=8000
DATABASE_SLOW_QUERY_MS=250
ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
REFRESH_TOKEN_SECRET=replace-with-a-different-at-least-32-char-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
WHATSAPP_RECOVERY_WEBHOOK_URL=
WHATSAPP_RECOVERY_WEBHOOK_TOKEN=

TRUST_PROXY_HOPS=1
OTP_HMAC_SECRET=replace-with-a-different-32-char-secret-for-otp-hmac
