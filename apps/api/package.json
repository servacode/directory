{
  "name": "@health/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "node ../../scripts/run-node-tests.mjs src && vitest run",
    "admin:create": "node dist/cli/create-admin.js",
    "evidence:purge": "node dist/cli/purge-verification-evidence.js",
    "pretest": "tsc -p tsconfig.auth-core.json && tsc -p tsconfig.admin-core.json && tsc -p tsconfig.availability-core.json && tsc -p tsconfig.duty-core.json && tsc -p tsconfig.facility-core.json && tsc -p tsconfig.rating-core.json && tsc -p tsconfig.security-core.json"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/platform-express": "^12.0.0",
    "@nestjs/config": "^4.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "helmet": "^8.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "@health/config": "workspace:*",
    "@health/contracts": "workspace:*",
    "argon2": "0.45.1",
    "jose": "6.2.12",
    "pg": "8.23.0",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/testing": "^12.0.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "typescript": "^7.0.0",
    "vitest": "^3.2.4",
    "eslint": "^9.35.0",
    "@types/pg": "8.23.1"
  }
}
